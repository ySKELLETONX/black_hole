#version 430
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba16f) writeonly uniform image2D outImage;

// All distances are in units of the Schwarzschild radius (rs = 1).
uniform vec3  uCamPos;
uniform vec3  uCamRight;
uniform vec3  uCamUp;
uniform vec3  uCamFwd;
uniform float uTanHalfFov;
uniform float uTime;
uniform int   uMaxSteps;
uniform float uStepScale;
uniform float uPixelAngle;   // angular size of one pixel (radians)
uniform float uRsMeters;     // Schwarzschild radius in meters (objects are in meters)

uniform int   uDiskEnabled;
uniform float uDiskInner;
uniform float uDiskOuter;
uniform float uDiskTemp;       // peak temperature (K)
uniform float uDiskBrightness;
uniform float uDiskDensity;
uniform float uDiskDetail;
uniform float uDiskSpeed;
uniform float uDoppler;        // 0 = off, 1 = physical beaming / redshift

uniform float uStarBrightness;
uniform float uGalaxyBrightness;

layout(std140, binding = 3) uniform Objects {
    int  numObjects;
    vec4 objPosRadius[16];
    vec4 objColor[16];
};

// ---------------------------------------------------------------- noise ---
float hash13(vec3 p3) {
    p3 = fract(p3 * 0.1031);
    p3 += dot(p3, p3.zyx + 31.32);
    return fract((p3.x + p3.y) * p3.z);
}
vec3 hash33(vec3 p3) {
    p3 = fract(p3 * vec3(0.1031, 0.1030, 0.0973));
    p3 += dot(p3, p3.yxz + 33.33);
    return fract((p3.xxy + p3.yxx) * p3.zyx);
}
float valueNoise(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    vec3 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(mix(hash13(i + vec3(0,0,0)), hash13(i + vec3(1,0,0)), u.x),
                   mix(hash13(i + vec3(0,1,0)), hash13(i + vec3(1,1,0)), u.x), u.y),
               mix(mix(hash13(i + vec3(0,0,1)), hash13(i + vec3(1,0,1)), u.x),
                   mix(hash13(i + vec3(0,1,1)), hash13(i + vec3(1,1,1)), u.x), u.y), u.z);
}
float fbm(vec3 p, int octaves) {
    float sum = 0.0, amp = 0.5;
    for (int i = 0; i < octaves; ++i) {
        sum += amp * valueNoise(p);
        p = p * 2.03 + vec3(1.7, 9.2, 3.1);
        amp *= 0.5;
    }
    return sum;
}

// ------------------------------------------------------------ blackbody ---
// Planck spectrum sampled at the sRGB primaries, normalized so 6500 K is white
// and returned at unit luminance.
vec3 planck(float T) {
    const vec3 lambda = vec3(610e-9, 549e-9, 468e-9);
    const float h = 6.626e-34, c = 2.998e8, k = 1.381e-23;
    vec3 l5 = lambda * lambda * lambda * lambda * lambda;
    return 1.0 / (l5 * (exp((h * c) / (lambda * k * T)) - 1.0));
}
vec3 blackbodyColor(float T) {
    T = clamp(T, 800.0, 40000.0);
    vec3 col = planck(T) / planck(6500.0);
    float lum = dot(col, vec3(0.2126, 0.7152, 0.0722));
    return col / max(lum, 1e-6);
}

// ----------------------------------------------------------- background ---
vec3 starLayer(vec3 d, float scale, float prob, float sizeMul, float gain) {
    vec3 id = floor(d * scale);
    if (hash13(id) > prob) return vec3(0.0);
    vec3 sp = normalize(id + 0.2 + 0.6 * hash33(id + 17.0));
    if (dot(sp, d) < 0.0) return vec3(0.0);
    float ang   = length(cross(sp, d));
    float sigma = uPixelAngle * sizeMul;
    float b     = exp(-ang * ang / (sigma * sigma));
    float mag   = pow(hash13(id + 3.1), 7.0) * 12.0 + 0.2;
    float T     = mix(2800.0, 15000.0, pow(hash13(id + 7.7), 1.6));
    return blackbodyColor(T) * b * mag * gain;
}

vec3 galaxy(vec3 d) {
    vec3  n    = normalize(vec3(0.25, 1.0, -0.35));
    float lat  = dot(d, n);
    float band = exp(-lat * lat * 16.0);
    vec3  cdir = normalize(vec3(0.8, -0.1, 0.55));
    float core = exp(-dot(d - cdir, d - cdir) * 2.2);
    float cloud = fbm(d * 3.0 + 2.0, 5);
    float dust  = smoothstep(0.42, 0.72, fbm(d * 7.0 + 11.0, 5));
    vec3  col   = mix(vec3(0.55, 0.62, 0.9), vec3(1.0, 0.78, 0.55), core);
    float I = band * (0.2 + cloud) * (1.0 - 0.85 * dust * exp(-lat * lat * 50.0))
            + core * band * 0.9;
    float neb = pow(fbm(d * 1.6 + 5.0, 4), 3.0);
    vec3  nebCol = mix(vec3(0.35, 0.12, 0.5), vec3(0.1, 0.3, 0.65), fbm(d * 2.3, 3));
    return (col * I * 0.12 + nebCol * neb * 0.12) * uGalaxyBrightness;
}

vec3 background(vec3 d) {
    vec3 s = starLayer(d, 45.0, 0.10, 1.1, 0.8)
           + starLayer(d, 90.0, 0.08, 0.8, 0.35)
           + starLayer(d, 160.0, 0.08, 0.7, 0.15);
    return s * uStarBrightness + galaxy(d);
}

// -------------------------------------------------------- accretion disk ---
float diskNoiseAt(float r, float ang, float seed) {
    vec3 q = vec3(cos(ang) * 1.6, sin(ang) * 1.6, r * 0.9 + seed) * uDiskDetail;
    float big = fbm(q, 5);
    vec3 s = vec3(cos(ang) * 7.0, sin(ang) * 7.0, r * 5.0 + seed) * uDiskDetail;
    float fine = fbm(s, 4);
    return big * 0.7 + fine * 0.5;
}

float diskDensity(vec2 xz, float r) {
    float phi   = atan(xz.y, xz.x);
    float omega = uDiskSpeed * 2.0 * pow(r, -1.5);   // Keplerian differential rotation
    // Two phases cross-faded so the differential shear never winds up forever.
    const float P = 16.0;
    float ph1 = fract(uTime / P);
    float ph2 = fract(uTime / P + 0.5);
    float n1 = diskNoiseAt(r, phi - omega * ph1 * P, 0.0);
    float n2 = diskNoiseAt(r, phi - omega * ph2 * P, 37.0);
    float w1 = 1.0 - abs(2.0 * ph1 - 1.0);
    return mix(n2, n1, w1);
}

// Returns emitted radiance (rgb) and opacity (a) where the ray crosses the disk plane.
vec4 shadeDisk(vec3 p, vec3 rayDir) {
    float r = length(p.xz);
    if (r < uDiskInner || r > uDiskOuter) return vec4(0.0);

    // Shakura-Sunyaev / Novikov-Thorne flux profile, peak normalized to 1
    float x = r / uDiskInner;
    float F = max(pow(x, -3.0) * (1.0 - inversesqrt(x)), 0.0) / 0.05666;
    float T = uDiskTemp * pow(F, 0.25);

    // Keplerian orbital speed seen by a static observer (rs = 1 -> M = 0.5)
    float beta  = min(sqrt(0.5 / max(r - 1.0, 1e-3)), 0.99);
    float gamma = inversesqrt(1.0 - beta * beta);
    vec3  vdir  = normalize(vec3(-p.z, 0.0, p.x));
    float cosT  = dot(vdir, -rayDir);                 // photon travels towards the camera
    float dop   = 1.0 / (gamma * (1.0 - beta * cosT));
    float grav  = sqrt(max(1.0 - 1.0 / r, 0.0));
    float g     = mix(1.0, dop * grav, uDoppler);

    float n = diskDensity(p.xz, r);
    float edge = smoothstep(uDiskInner, uDiskInner * 1.12, r)
               * (1.0 - smoothstep(uDiskOuter * 0.55, uDiskOuter, r));

    float gas = smoothstep(0.25, 0.95, n);
    vec3  col = blackbodyColor(T * g) * F * pow(g, 4.0) * uDiskBrightness * (0.15 + 1.8 * gas);
    float tau = (0.15 + 3.0 * gas * gas) * uDiskDensity * edge;
    float alpha = 1.0 - exp(-tau / max(abs(rayDir.y), 0.04));
    return vec4(col, alpha);
}

// ------------------------------------------------------------- objects ---
// Segment/sphere test between two consecutive integration points.
bool hitObjects(vec3 a, vec3 b, out vec3 col) {
    vec3 seg = b - a;
    float segLen2 = dot(seg, seg);
    float bestT = 2.0;
    col = vec3(0.0);
    for (int i = 0; i < numObjects; ++i) {
        float R = objPosRadius[i].w / uRsMeters;
        if (R <= 1.01) continue;                       // the black hole itself
        vec3 C = objPosRadius[i].xyz / uRsMeters;
        vec3 oc = a - C;
        float B = dot(oc, seg);
        float Cc = dot(oc, oc) - R * R;
        float disc = B * B - segLen2 * Cc;
        if (disc < 0.0) continue;
        float t = (-B - sqrt(disc)) / segLen2;
        if (t < 0.0 || t > 1.0 || t >= bestT) continue;
        bestT = t;
        vec3 P  = a + seg * t;
        vec3 N  = normalize(P - C);
        float mu = max(dot(N, -normalize(seg)), 0.0);
        float gran = fbm(N * 9.0 + vec3(0.0, uTime * 0.15, 0.0), 4);
        float limb = 0.35 + 0.65 * pow(mu, 0.6);       // limb darkening
        col = objColor[i].rgb * limb * (0.7 + 0.6 * gran) * 1.3;
    }
    return bestT <= 1.0;
}

// ------------------------------------------------------------ geodesic ---
// Photon orbit in Schwarzschild spacetime written in Cartesian form:
//   x'' = -1.5 * h^2 * x / r^5,  h = |x cross x'|  (conserved)
vec3 accel(vec3 x, float h2) {
    float r2 = dot(x, x);
    return -1.5 * h2 * x / (r2 * r2 * sqrt(r2));
}
void rk4(inout vec3 x, inout vec3 v, float dt, float h2) {
    vec3 k1x = v;                   vec3 k1v = accel(x, h2);
    vec3 k2x = v + 0.5 * dt * k1v;  vec3 k2v = accel(x + 0.5 * dt * k1x, h2);
    vec3 k3x = v + 0.5 * dt * k2v;  vec3 k3v = accel(x + 0.5 * dt * k2x, h2);
    vec3 k4x = v + dt * k3v;        vec3 k4v = accel(x + dt * k3x, h2);
    x += dt / 6.0 * (k1x + 2.0 * k2x + 2.0 * k3x + k4x);
    v += dt / 6.0 * (k1v + 2.0 * k2v + 2.0 * k3v + k4v);
}

void main() {
    ivec2 pix  = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outImage);
    if (pix.x >= size.x || pix.y >= size.y) return;

    float aspect = float(size.x) / float(size.y);
    vec2  uv  = (vec2(pix) + 0.5) / vec2(size) * 2.0 - 1.0;
    vec3  dir = normalize(uCamFwd + uv.x * aspect * uTanHalfFov * uCamRight
                                  + uv.y * uTanHalfFov * uCamUp);

    float sceneR = max(length(uCamPos), uDiskOuter);
    for (int i = 0; i < numObjects; ++i)
        sceneR = max(sceneR, (length(objPosRadius[i].xyz) + objPosRadius[i].w) / uRsMeters);
    float escapeR = max(sceneR * 4.0, 200.0);

    vec3 x = uCamPos;
    vec3 v = dir;
    vec3 hv = cross(x, v);
    float h2 = dot(hv, hv);

    vec3  col   = vec3(0.0);
    float trans = 1.0;
    bool  done  = false;

    for (int i = 0; i < uMaxSteps; ++i) {
        float r = length(x);
        if (r < 1.0) { done = true; break; }                        // event horizon
        if (r > escapeR && dot(x, v) > 0.0) break;                   // escaped
        if (trans < 0.01) { done = true; break; }

        float dt = uStepScale * r / length(v);
        vec3 xPrev = x;
        rk4(x, v, dt, h2);

        vec3 objCol;
        if (hitObjects(xPrev, x, objCol)) {
            col += trans * objCol;
            done = true;
            break;
        }

        if (uDiskEnabled != 0 && xPrev.y * x.y < 0.0) {
            float t = xPrev.y / (xPrev.y - x.y);
            vec3  p = mix(xPrev, x, t);
            vec4  d = shadeDisk(p, normalize(v));
            col   += trans * d.a * d.rgb;
            trans *= 1.0 - d.a;
        }
    }

    if (!done) col += trans * background(normalize(v));
    imageStore(outImage, pix, vec4(col, 1.0));
}
